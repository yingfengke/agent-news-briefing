# === 主模型：DeepSeek 官方 API（必须配置，否则 AI 分析无法运行） ===
MODEL_BASE_URL=https://api.deepseek.com
MODEL_API_KEY=sk-你的DeepSeek密钥
MODEL_NAME=deepseek-flash

# === 通用网关：硅基流动（向量模型与轻量模型使用） ===
API_BASE_URL=https://api.siliconflow.cn
API_KEY=sk-你的硅基流动密钥

# === 轻量模型与向量模型（可选，不配置则使用默认值） ===
SUMMARY_MODEL_NAME=THUDM/GLM-4-9B-0414
TWITTER_FILTER_MODEL_NAME=THUDM/GLM-4-9B-0414
EMBEDDING_MODEL=BAAI/bge-m3

# === 兜底模型（可选，默认不启用） ===
# FALLBACK_MODEL_NAME=

# === QQ邮箱 SMTP 配置（必须配置，否则邮件无法发送） ===
SENDER_EMAIL=你的QQ号@qq.com
AUTH_CODE=你的16位授权码
RECEIVER_EMAIL=收件邮箱地址
SMTP_SERVER=smtp.qq.com
SMTP_PORT=465
